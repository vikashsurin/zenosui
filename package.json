{
	"name": "ui-lib",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack && npm run generate:safelist",
		"postbuild": "node src/scripts/fixfileExtension.js",
		"generate:safelist": "node  src/scripts/generateSafelist.js",
		"preview": "vite preview",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"prepare": "npm run build && npm run generate:safelist && npm run prepack",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.16.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.3.2",
		"@eslint/js": "^9.35.0",
		"@lucide/svelte": "^0.525.0",
		"@sveltejs/kit": "^2.37.1",
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.1.13",
		"@types/glob": "^8.1.0",
		"@types/node": "^24.3.1",
		"eslint": "^9.35.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.2",
		"glob": "^11.0.3",
		"globals": "^16.3.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"publint": "^0.3.12",
		"svelte": "^5.38.7",
		"svelte-check": "^4.3.1",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.43.0",
		"vite": "^6.3.6",
		"vite-plugin-devtools-json": "^0.2.1"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^1.0.0"
	}
}
